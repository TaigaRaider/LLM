# Copy to .env and adjust. All vars optional unless noted.

# --- server ---
LLM_DATABASE_URL=sqlite:///./llm.db
LLM_JWT_SECRET=change-me-to-a-long-random-string
LLM_CORS_ORIGINS=["*"]
LLM_DEFAULT_OFFICER_PASSWORD=officer123

# --- external participant system (the existing system) ---
# Required to enable live sync:
LLM_EXTERNAL_SYNC_ENABLED=false
LLM_EXTERNAL_API_BASE_URL=https://registry.example.org/api
LLM_EXTERNAL_API_TOKEN=
# Full-snapshot endpoint (list of participant records)
LLM_EXTERNAL_API_PARTICIPANTS_PATH=/participants
# Optional incremental endpoint; called with ?updated_since=<ISO>. Leave empty to use snapshot polling.
LLM_EXTERNAL_API_DELTA_PATH=
# Field mapping from their record keys to ours: id / name / id_number / phone / group
LLM_EXTERNAL_API_FIELD_MAP={"id": "id", "name": "name", "id_number": "idNumber", "phone": "phone", "group": "group"}
LLM_EXTERNAL_SYNC_INTERVAL_SECONDS=30
LLM_EXTERNAL_SYNC_TIMEOUT_SECONDS=15